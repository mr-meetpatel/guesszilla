# Copy to .env. Obtain IDs and credentials from your Slack app/workspace.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_TEAM_ID=T_REPLACE_ME
SLACK_CHANNEL_ID=C_REPLACE_ME
SEND_STATS_PASSWORD=replace-with-a-long-random-password

# Generate with: make secrets (prints new values; never commit your .env).
ADMIN_PANEL_ENABLED=true
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
CREDENTIAL_ENCRYPTION_KEYS=replace-with-a-fernet-key
PUBLIC_URL=http://localhost:8080
# For local HTTP only. Always use true behind production HTTPS.
COOKIE_SECURE=false
PERSIST_LOGS=true
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
FRONTEND_PORT=8080
API_PORT=8000

# Local PostgreSQL for native development (Docker overrides the host with "db").
DB_BACKEND=local
POSTGRES_USER=wordle
POSTGRES_PASSWORD=wordle-local-only
POSTGRES_DB=wordle
# Host port for local PostgreSQL; the container always listens on 5432.
DB_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://wordle:wordle-local-only@localhost:15432/wordle
# Optional separate migration credential; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+psycopg://...

# Hosted Supabase: switch DB_BACKEND and DATABASE_URL.
# DB_BACKEND=supabase
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

APP_TIMEZONE=Asia/Kolkata
APP_ENV=development
AUTO_MIGRATE=true
PORT=8000
DB_POOL_SIZE=3
WEB_WORKERS=1
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
HEARTBEAT_MAX_AGE_SECONDS=90
LOG_LEVEL=INFO
