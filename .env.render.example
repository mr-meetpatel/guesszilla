# Deployment credentials only. Copy to .env.render (gitignored).
# Runtime secrets belong in Render's wordle-platform-common environment group.
RENDER_API_KEY=replace-with-render-api-key
RENDER_API_SERVICE_ID=srv-replace-api
RENDER_WORKER_SERVICE_ID=srv-replace-worker
RENDER_SCHEDULER_SERVICE_ID=srv-replace-scheduler
RENDER_ADMIN_SERVICE_ID=srv-replace-admin
# Full commit SHA from main that has passed CI.
RENDER_COMMIT_SHA=
